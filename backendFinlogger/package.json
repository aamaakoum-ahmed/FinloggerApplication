{
  "name": "backendfinlogger",
  "version": "1.0.0",
  "description": "FinLogger backend with Express and MongoDB",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha tests/**/*.test.js --timeout 10000 --exit",
    "test:models": "mocha tests/models/*.test.js --timeout 10000 --exit",
    "test: controllers": "mocha tests/controllers/*.test.js --timeout 10000 --exit",
    "test: coverage": "nyc npm test"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^1.14.10",
    "nyc": "^14.1.1",
    "supertest": "^7.3.1"
  }
}
